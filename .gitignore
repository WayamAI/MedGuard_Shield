# Local environment (.env.example is the committed template)
.env
.env.local
.env.*.local
# Added by `vercel link`, which writes VERCEL_OIDC_TOKEN into .env.local.
# Broader than the three lines above on purpose -- but .env.example is the
# documentation of what to set, and it has to stay committable.
.env*
!.env.example

# Agent tooling, not application code. `.agents/` holds skill documents pulled
# down by an editor integration, `.claude/` is that integration's workspace,
# and skills-lock.json pins their versions. Nothing in the app imports any of
# it and the production build succeeds without it, so it stays out of the repo
# rather than riding along in every diff.
.agents/
.claude/
skills-lock.json
