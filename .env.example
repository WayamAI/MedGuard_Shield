# MedGuard frontend environment
#
# Copy to `.env` (git-ignored) and fill in before running against a backend.

# Base URL of the MedGuard backend API, no trailing slash.
# The API client (src/lib/apiClient.ts) prefixes every request with this, so
# /api/dataflows becomes ${VITE_API_BASE_URL}/api/dataflows.
# Leave unset while the app runs on mock data.
VITE_API_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Authentication
#
# Not yet wired. src/hooks/use-auth.tsx is still the demo layer: any valid
# email plus any non-empty password signs in, session kept in localStorage.
#
# When the real provider is chosen, it registers its token source once via
# setAuthTokenGetter() from src/lib/apiClient.ts and adds its own vars here,
# e.g. VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY, or
#      VITE_CLERK_PUBLISHABLE_KEY.
# ---------------------------------------------------------------------------
