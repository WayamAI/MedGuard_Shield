# MedGuard frontend environment
#
# Copy to `.env.local` (git-ignored) before running. The app has no mock
# fallback for the API-backed pages: without this set, `getApiBaseUrl()` in
# src/lib/apiClient.ts throws and those pages render their error state.

# Base URL of the MedGuard backend API, no trailing slash.
# The API client prefixes every request with this, so /api/dataflows becomes
# ${VITE_API_BASE_URL}/api/dataflows.
#
# 4000 is the port the backend listens on — src/test/live-backend.test.tsx
# asserts against it directly (`lsof -ti:4000`).
VITE_API_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Authentication
#
# Fully wired, and needs no variables of its own. src/hooks/use-auth.tsx signs
# in against POST /api/auth/login and registers its token source with
# setAuthTokenGetter() from src/lib/apiClient.ts, so every subsequent request
# carries the bearer token.
#
# The token is held in memory only — never localStorage or sessionStorage — so
# a reload ends the session and lands on /login. The API has no refresh-token
# endpoint, so there is nothing to silently re-authenticate against.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Integration tests (optional)
#
# src/test/live-backend.test.tsx runs against a real backend and skips itself
# when one is not reachable. Credentials come from the environment, never the
# repo:
#   DEMO_USER_EMAIL=admin@meridian.org \
#   DEMO_USER_PASSWORD=... npx vitest run src/test/live-backend.test.tsx
# ---------------------------------------------------------------------------
