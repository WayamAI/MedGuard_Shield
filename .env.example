# MedGuard has no backend and requires no environment variables to run.
#
# Demo authentication (src/hooks/use-auth.tsx) accepts any syntactically
# valid email and any non-empty password, and stores the session in the
# browser's localStorage. No API keys, database URLs, or secrets are used.
#
# This file exists as a placeholder for when real authentication or a
# backend API is introduced. At that point, typical variables would be:
#
# VITE_API_BASE_URL=
# VITE_AUTH_PROVIDER_DOMAIN=
